{
  "name": "apartment-planner",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Interactive 3D apartment showcase and floor-plan furniture planner",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8765 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 8765 --strictPort",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "9.4.2",
    "@react-three/postprocessing": "3.0.4",
    "n8ao": "1.10.1",
    "polygon-clipping": "0.15.7",
    "postprocessing": "6.38.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "0.181.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.181.0",
    "@vitejs/plugin-react": "5.1.1",
    "jsdom": "27.2.0",
    "typescript": "5.9.3",
    "vite": "7.2.4",
    "vitest": "4.0.14"
  }
}
